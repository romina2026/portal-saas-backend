# ── Base de datos (Supabase) ──────────────────────────────────
# Copiá este valor desde: Supabase > Settings > Database > Connection string
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres

# ── JWT ───────────────────────────────────────────────────────
# Generá un string random largo, ej: openssl rand -base64 48
JWT_SECRET=cambia_esto_por_un_string_muy_largo_y_random

# ── Sistema manager ───────────────────────────────────────────
MANAGER_API_URL=https://tu-manager.com/api
MANAGER_API_KEY=token_del_sistema_manager

# ── Supabase Storage (para recibos en PDF) ────────────────────
# Copiá desde: Supabase > Settings > API
SUPABASE_URL=https://[REF].supabase.co
SUPABASE_SERVICE_KEY=eyJ...  # service_role key (NO la anon key)
STORAGE_BUCKET=recibos

# ── Servidor ──────────────────────────────────────────────────
PORT=3000
FRONTEND_URL=http://localhost:5173

# ── Web Push (notificaciones) ─────────────────────────────────
# Generá con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@tuempresa.com
